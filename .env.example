# PostgreSQL
DATABASE_URL="postgresql://image_library:change-me@localhost:5432/image_library?schema=public"

# Auth.js. Generate a unique value for each environment and never commit the real secret.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Development-only administrator seed. Set real local values before `npm run db:seed`.
DEV_ADMIN_EMAIL="admin@example.test"
DEV_ADMIN_USERNAME="admin"
DEV_ADMIN_PASSWORD="replace-with-a-local-development-password"

# Local storage only. This must be a server-readable directory, never exposed as a browser filesystem path.
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./data/storage"

# Upload policy
MAX_UPLOAD_BYTES="26214400"
MAX_ZIP_UPLOAD_BYTES="262144000"
MAX_ZIP_ENTRIES="500"
MAX_ZIP_UNCOMPRESSED_BYTES="314572800"
